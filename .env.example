# ==================================================
# GUÍA DE CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==================================================
# Para desarrollo local, puedes crear un archivo .env o configurar
# las variables de entorno en tu IDE/sistema operativo.

# Base de datos
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=CaichDB;encrypt=false
DB_USERNAME=sa
DB_PASSWORD=YourStrong!Passw0rd

# JWT - CRÍTICO: Cambia esto en producción
# Genera un secret seguro con: openssl rand -base64 64
JWT_SECRET=tu-secret-muy-largo-y-seguro-aqui-minimo-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Servidor
SERVER_PORT=8080
APP_ENVIRONMENT=development

# Archivos
FILE_UPLOAD_DIR=./uploads/profiles/

# Errores (en producción, usa 'on_param' o 'never')
ERROR_INCLUDE_MESSAGE=always
ERROR_INCLUDE_STACKTRACE=on_param
ERROR_INCLUDE_BINDING_ERRORS=always

# ==================================================
# CONFIGURACIÓN EN INTELLIJ IDEA / VS CODE
# ==================================================
# IntelliJ IDEA:
# Run → Edit Configurations → Environment Variables
# Agrega cada variable manualmente o importa desde archivo .env

# VS Code:
# En launch.json, agrega:
# "env": {
#   "DB_PASSWORD": "YourStrong!Passw0rd",
#   "JWT_SECRET": "tu-secret-seguro"
# }

# ==================================================
# PRODUCCIÓN
# ==================================================
# 1. Nunca uses valores por defecto para secrets
# 2. Usa servicios de gestión de secrets:
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - HashiCorp Vault
# 3. Configura variables de entorno en tu servidor
# 4. Cambia ERROR_INCLUDE_STACKTRACE a 'never'
